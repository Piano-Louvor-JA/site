{
  "name": "piano-louvorja-site",
  "version": "1.6.0",
  "description": "PIANO LouvorJA — Landing page do gerenciador de cultos web",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "author": "Equipe LouvorJA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Piano-Louvor-JA/site.git"
  },
  "homepage": "https://pianolouvorja.com.br",
  "bugs": {
    "url": "https://github.com/Piano-Louvor-JA/site/issues"
  },
  "engines": {
    "node": ">=24.6.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "test:mutation": "stryker run",
    "build": "node scripts/postinstall-host.mjs && nuxt build",
    "dev": "nuxt dev",
    "generate": "node scripts/postinstall-host.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/postinstall-host.mjs && nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run --coverage && playwright test",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "SB_DISABLE_TELEMETRY=1 CI=true storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@octokit/rest": "^22.0.1",
    "@tabler/icons-webfont": "^3.49.0",
    "apexcharts": "^7.8.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "h3": "1.15.11",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.0.15",
    "nuxt": "^4.6.0",
    "nuxt-gtag": "^5.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@sentry/browser": "^9.47.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/vue3": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/html-to-text": "^9.0.4",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.5.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "firebase-tools": "^15.32.1",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "semantic-release": "^25.0.9",
    "storybook": "^8.6.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.12"
  }
}
